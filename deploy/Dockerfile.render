# Combined Core + Relay image for one free Render web service.
# Build context: repo root.
FROM node:20-bookworm-slim AS node

FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=node /usr/local /usr/local

WORKDIR /repo

COPY shared/python shared/python
COPY pyproject.toml ./
COPY intelligence intelligence
COPY finchnode finchnode
COPY fetch fetch
COPY core core
RUN pip install --no-cache-dir -e shared/python -e . -e "core[postgres]" \
    && mkdir -p /repo/.data

COPY shared shared
COPY relay/package.json relay/package-lock.json relay/
RUN cd relay && npm ci --omit=dev --no-audit --no-fund
COPY relay relay
RUN mkdir -p /repo/relay/data

COPY deploy/start_render.sh deploy/proxy.py deploy/
RUN chmod +x /repo/deploy/start_render.sh

EXPOSE 10000
CMD ["sh", "/repo/deploy/start_render.sh"]
